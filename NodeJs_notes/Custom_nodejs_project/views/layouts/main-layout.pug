doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title #{docTitle}
        link(rel="stylesheet", href="/css/main.css")
        block stylesheets
    body 
        header.main-header 
            nav.main-header__nav
                ul.main-header__item-list
                    li.main-header__item
                        a(href="/home", class=(path === '/home' ? 'active': '')) Shop
                    li.main-header__item
                        a(href="/admin/add-user", class=(path === 'adminpath' ? 'active': '')) Add Users
        block content

