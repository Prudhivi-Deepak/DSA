<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/users.css">
    <link rel="stylesheet" href="/css/forms.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main>
                <!-- <h1>My Products</h1>
        <p>List of all the products...</p> -->
                <% if (users.length> 0) { %>
                    <div class="grid">
                        <% for(let user of users) { %>
                            <article class="card product-item">
                                <header class="card__header">
                                    <h1 class="product__title">
                                        <%= user.title %>
                                    </h1>
                                </header>
                                <div class="card__image">
                                    <!-- <img src="https://cdn.pixabay.com/photo/2016/03/31/20/51/book-1296045_960_720.png" alt="A Book"> -->
                                    <img src="<%= user.imageUrl %>" alt="A Book">
                                </div>
                                <div class="card__content">
                                    <h2 class="product__price">$<%= user.price %>
                                    </h2>
                                    <p class="product__description">
                                        <%= user.description %>
                                    </p>
                                </div>
                                <div class="card__actions">
                                    <a href="/admin/edit-user/"><button class="btn">Edit</button></a>
                                    <form action="/admin/delete-user/" method="POST" style="display:inline;">
                                        <button class="submit">Delete</button>
                                    </form>
                                </div>
                            </article>
                            <% } %>
                    </div>
                    <% } else {%>
                        <h1>No Users Found</h1>
                        <% } %>
            </main>
            <%- include('../includes/end.ejs') %>