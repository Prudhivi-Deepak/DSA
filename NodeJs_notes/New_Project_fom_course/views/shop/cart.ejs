<%- include('../includes/head.ejs') %>
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <% if(products.length>0){ %>
                    <ul>
                        <% for( p of products){ %>
                            <p>
                                <%=p.cartItem.id%>
                            </p>
                            <li>
                                <p> Titlte : <%=p.title %>
                                </p>
                            <li>
                                <p>Quantity : (<%=p.cartItem.quantity %>)</p>
                                <form action="/cart-delte-item/<%=p.id %>" method="POST">
                                    <input type="hidden" name="productId" value="<%=p.cartItem.id %>" />
                                    <button class="btn" type="submit">Delete</button>
                                </form>
                            </li>
                            <%}%>
                    </ul>
                    <div class="centered" >
                        <form action="/create-order" method="post">
                            <button class="btn" type="submit">
                                Order Now!
                            </button>
                        </form>
                    </div>
                    <% }else{%>
                        <p> No Products added in cart!! </p>
                        <%}%>

            </main>
            <%- include('../includes/end.ejs') %>