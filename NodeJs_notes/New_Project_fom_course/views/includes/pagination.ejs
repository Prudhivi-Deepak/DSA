<section class="pagination">
    <% if(hasPrevPage){ %><a href="?page=<%=previousPage%>">
            <%=previousPage%>
        </a>
        <%}%>
            <!-- <% if(currentPage!==1){ %><a href="?page=1">1</a> <%}%> -->
            <a href="?page=<%=currentPage%>" class="active">
                <%=currentPage%>
            </a>
            <% if(hasNextPage){ %><a href="?page=<%=nextPage%>">
                    <%=nextPage%>
                </a>
                <%}%>
                    <% if(lastPage!==currentPage && nextPage !==lastPage){ %><a href="?page=<%=lastPage%>">
                            <%=lastPage%>
                        </a>
                        <%}%>
                            <!-- <a href="?page=2">2</a> -->
</section>