#include<bits/stdc++.h>
using namespace std;

int CountPairsMaxDiff(vector<int> arr){
    sort(arr.begin(), arr.end());
    int largest = 0;
    for(int i=0; i<arr.size(); i+=2){
        largest = max(largest, abs(arr[i]-arr[i+1]));
    }
    return largest;
}

int main(){
    int T, n;
    vector<int> arr;
    cin >> T;
    
    for(int i=0; i<T; i++){
        cin >> n;
        for(int j=0; j<n; j++){
            int temp;
            cin >> temp;
            arr.push_back(temp);
        }
        cout << CountPairsMaxDiff(arr) << endl;
        arr.clear();
    }
}